{
  "manifest_version": 3,
  "name": "HuntBoard — 1-Click Job Saver",
  "version": "1.0.0",
  "description": "Capture job vacancies directly from LinkedIn, Indeed, and Glassdoor into your HuntBoard Kanban pipeline.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "http://localhost:3000/*",
    "https://*.linkedin.com/*",
    "https://*.glassdoor.com/*",
    "https://*.indeed.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Save to HuntBoard"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.linkedin.com/*",
        "https://*.glassdoor.com/*",
        "https://*.indeed.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}

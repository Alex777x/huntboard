# ==============================================================================
# HuntBoard — Production Environment Variables Configuration Template
# Copy this file to .env.local for local development, or configure in Vercel Settings
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Cloud Configuration (Required)
# Retrieve from: Supabase Project Settings -> API
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# ------------------------------------------------------------------------------
# 2. Application URL (Required for OAuth redirects, PWA manifest & SSRF checks)
# Development: http://localhost:3000
# Production: https://your-domain.com or https://your-app.vercel.app
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 3. Cryptography & AI Provider Keys
# AI_ENCRYPTION_SECRET is used for AES-256-GCM encryption of user AI keys.
# Generate via: openssl rand -hex 32
# ------------------------------------------------------------------------------
AI_ENCRYPTION_SECRET=
OPENAI_API_KEY=

# ------------------------------------------------------------------------------
# 4. Telegram Notifications Bot (Optional)
# Used for instant dispatch of recruiter interviews and invite alerts
# Create a bot via @BotFather on Telegram
# ------------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_DEFAULT_CHAT_ID=

# ------------------------------------------------------------------------------
# 5. Production Node Environment & Dev Overrides
# Set to "production" in deployed cloud environments
# Set HUNTBOARD_DEV_PREVIEW=1 to preview UI routes locally without Supabase credentials
# ------------------------------------------------------------------------------
NODE_ENV=development
HUNTBOARD_DEV_PREVIEW=0

# ------------------------------------------------------------------------------
# 6. Chrome Extension Integration (Optional)
# Specify your unpacked or Web Store Extension ID (e.g. abcdefghijklmnop)
# ------------------------------------------------------------------------------
CHROME_EXTENSION_ID=
